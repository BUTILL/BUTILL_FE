# Supabase 프로젝트 주소와 publishable 키 (백엔드 .env의 SUPABASE_URL / SUPABASE_KEY와 같은 프로젝트)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 배포 API 서버 주소 (비우면 개발 서버 프록시로 /api/v1 사용)
VITE_API_BASE_URL=

# 상세 분석 웹 주소 (web/ 또는 C:\Projects\BUTILL_WEB, 기본 포트 5174)
VITE_SIMULATION_ANALYSIS_URL=http://localhost:5174/
VITE_RAW_MATERIALS_WEB_URL=http://localhost:5174/raw-materials
VITE_TAX_ANALYSIS_WEB_URL=http://localhost:5174/tax
